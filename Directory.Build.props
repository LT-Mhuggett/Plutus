<Project>

  <!--
    THE TILL VERSION — one number, every till, bumped by hand.

    Matt, 2026-08-08: "Can we add a 'Till version' please which we can increment with each build,
    so I can see what version we are testing and it's not just a time stamp."

    The web till showed only `__BUILD_TIME__` (an ISO timestamp injected by vite.config.ts), which
    answers "when was this compiled" and not "which build am I looking at". Two builds ten minutes
    apart are indistinguishable in a bug report, and a timestamp cannot be quoted down a phone.

    ⚠ The version lives in ONE file — `till-version.txt` at the repo root — because it has to be the
    SAME number on every surface or it is worse than useless. This props file feeds every .NET
    project (backend, MAUI till, client libraries); `vite.config.ts` reads the same file for the web
    till and the portal. Bump the file, rebuild, and all of them agree.

    TO RELEASE: edit till-version.txt, commit it with the build, deploy. Nothing else to touch.
  -->
  <PropertyGroup>
    <TillVersion Condition="Exists('$(MSBuildThisFileDirectory)till-version.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)till-version.txt').Trim())</TillVersion>
    <TillVersion Condition="'$(TillVersion)' == ''">0.0.0</TillVersion>

    <!-- InformationalVersion takes any string and is what we read back at runtime. Version/
         AssemblyVersion are left alone deliberately: they must parse as numeric quads, and the
         MAUI head already sets its own ApplicationDisplayVersion for the store listing. -->
    <InformationalVersion>$(TillVersion)</InformationalVersion>
  </PropertyGroup>

</Project>
