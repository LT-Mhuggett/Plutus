<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- WP1.2: this box has AspNetCore.App x64 only at 10.x; roll the test host forward so
         the net8 test assembly runs against the installed shared framework. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- WP1.2: HttpTenantContext tests use DefaultHttpContext from the ASP.NET shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plutus.SharedKernel\Plutus.SharedKernel.csproj" />
    <!-- WP1.1: tenancy model + query-filter tests need the legacy MySqlDbContext. -->
    <ProjectReference Include="..\..\Plutus\Commons\Plutus.Entities\Plutus.Entities.csproj" />
    <!-- WP1.2: JWT-claim resolution tests. -->
    <ProjectReference Include="..\..\src\Plutus.Tenancy\Plutus.Tenancy.csproj" />
    <!-- WP1.2: token auth-handler tests. -->
    <ProjectReference Include="..\..\src\Plutus.Identity\Plutus.Identity.csproj" />
    <!-- WP1.4: sale ingest tests. -->
    <ProjectReference Include="..\..\src\Plutus.Sales\Plutus.Sales.csproj" />
    <!-- WP1.5: outbox dispatcher tests. -->
    <ProjectReference Include="..\..\src\Plutus.Web.Infrastructure\Plutus.Web.Infrastructure.csproj" />
    <!-- WP1.8: Kapow migration transforms + mapper. -->
    <ProjectReference Include="..\..\Plutus\Tools\Plutus.Migration.Kapow\Plutus.Migration.Kapow.csproj" />
    <!-- WP2.1: legacy sale bridge projection tests. -->
    <ProjectReference Include="..\..\src\Plutus.Reporting\Plutus.Reporting.csproj" />
    <!-- WP5.1: stock ledger tests. -->
    <ProjectReference Include="..\..\src\Plutus.Catalogue\Plutus.Catalogue.csproj" />
  </ItemGroup>

</Project>
