# Phase 9 auth mode for the portal build.
# Leave unset (or "password") for the test env's HMAC email/password login.
# Set "oidc" to sign in via Keycloak or Entra External ID (auth-code + PKCE).

# VITE_AUTH_MODE=oidc
# Keycloak:
# VITE_OIDC_AUTHORITY=https://login.plutus.huggett.dscloud.me/realms/plutus
# VITE_OIDC_CLIENT_ID=plutus-portal
# Entra External ID:
# VITE_OIDC_AUTHORITY=https://<subdomain>.ciamlogin.com/<tenantId>/v2.0
# VITE_OIDC_CLIENT_ID=<plutus-portal app id>
