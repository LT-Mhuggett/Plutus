<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Frontend.AppClient.Views.Platform.ConnectionView"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <!--
        The Plutus tab: connect this till to the platform, and prove each layer answers.

        Diagnostics, not a sales screen. Every action is a BUTTON and nothing runs on a timer — a
        screen that fires background work while someone is reading it cannot be reasoned about when
        it misbehaves, which is exactly when this screen is being looked at.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="720">

            <!--
                ⚠⚠ THE WAY OUT — till-design D4 rules 1 and 2, added 2026-08-19 after Matt: *"If I go
                into settings and 'Till device' Connections, enrollment and diagnostics. I cannot exit
                this screen. There is no Close and esc doesnt work"*.

                This page was only ever a TAB, where leaving it meant tapping another tab. §5c item 9
                un-tabbed it and pushed it MODALLY instead — and a modal ContentPage has no back
                affordance, so the only exit was killing the app. On a counter that is a shop that
                cannot trade, which is the exact harm D4 exists to prevent.

                ⚠ HIDDEN ON FIRST RUN. The same page is the pre-sign-in enrolment screen, and there is
                nothing behind it to close back to — see the code-behind, which owns that decision.
            -->
            <Button x:Name="CloseButton"
                    Text="Close"
                    Clicked="OnCloseClicked"
                    HorizontalOptions="End"
                    IsVisible="False"/>

            <!-- ── connection ── -->
            <Label Text="Connection" FontSize="Title"/>
            <Grid ColumnSpacing="10" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Colour is a hint, never the message: red/amber/green alone is unreadable to the
                     ~8% of men with a colour-vision deficiency, and the TEXT is what says which of
                     three different people to ring. -->
                <Ellipse Grid.Row="0" Grid.Column="0" WidthRequest="12" HeightRequest="12"
                         VerticalOptions="Center" Fill="{Binding ConnectionColour}"/>
                <Label Grid.Row="0" Grid.Column="1" FontSize="Body" VerticalOptions="Center"
                       Text="{Binding ConnectionSummary}"/>
                <Label Grid.Row="1" Grid.Column="1" FontSize="Caption" Opacity="0.7"
                       Text="{Binding ConnectionDetail}"/>
            </Grid>

            <Label Text="Server address" FontSize="Caption" Opacity="0.7"/>
            <Entry Text="{Binding ServerUrl}" Placeholder="https://plutus.example.com" Keyboard="Url"/>

            <Button Text="Check connection" Command="{Binding CheckCommand}" IsEnabled="{Binding NotBusy}"/>

            <BoxView HeightRequest="1" Color="{DynamicResource ThemeLine}"/>

            <!-- ── this till's identity ── -->
            <Label Text="This till" FontSize="Title"/>
            <Label FontSize="Caption" Text="{Binding DeviceSummary}"/>

            <Label Text="Enrolment code (from the portal — Locations → Tills)" FontSize="Caption" Opacity="0.7"/>
            <Entry Text="{Binding EnrolmentCode}" Placeholder="e.g. 4KQ7WX2M" MaxLength="16"/>
            <Button Text="Enrol this till" Command="{Binding EnrolCommand}" IsEnabled="{Binding NotBusy}"/>

            <BoxView HeightRequest="1" Color="{DynamicResource ThemeLine}"/>

            <!-- ── prove the layers ── -->
            <Label Text="Check the platform answers" FontSize="Title"/>
            <Label FontSize="Caption" Opacity="0.7"
                   Text="Each button exercises one layer built by the retrofit, so a failure points at a specific thing rather than at 'the network'."/>
            <Button Text="Send a heartbeat" Command="{Binding BeatCommand}" IsEnabled="{Binding NotBusy}"/>
            <Button Text="Read the catalogue feed" Command="{Binding CatalogueCommand}" IsEnabled="{Binding NotBusy}"/>
            <!-- ⚠ Forgets the cursor and pulls everything again. It exists because adding a FIELD
                 to the feed reaches an existing till only for items that change afterwards — so
                 without this, brand/description/cost would arrive on three items and never on the
                 other twenty thousand, with nothing to say so. -->
            <Button Text="Re-download the whole catalogue" Command="{Binding ResyncCatalogueCommand}" IsEnabled="{Binding NotBusy}"/>
            <Button Text="Sync staff from the portal" Command="{Binding SyncStaffCommand}" IsEnabled="{Binding NotBusy}"/>
            <!-- ⚠ The only place a stuck sales queue is visible. The cadence drains silently every
                 60s, so a till holding a day of un-sent sales — or sales Plutus REFUSED — looks
                 identical to a healthy one from the sales screen. -->
            <Button Text="Send queued sales now" Command="{Binding SendSalesCommand}" IsEnabled="{Binding NotBusy}"/>

            <ActivityIndicator IsVisible="{Binding Busy}" IsRunning="{Binding Busy}" HorizontalOptions="Start"/>
            <Label FontSize="Caption" Text="{Binding LastAction}" LineBreakMode="WordWrap"/>

            <!-- First run only: the route on to sign-in. ⚠ Deliberately NOT gated on being
                 enrolled — a till whose broadband is down must still reach its own login screen. -->
            <Button Text="Continue to sign in" Command="{Binding ContinueCommand}" IsVisible="{Binding ShowContinue}"/>

            <BoxView HeightRequest="1" Color="{DynamicResource ThemeLine}"/>

            <!-- ⚠⚠ ASK FIRST, FORGET SECOND, and in that order on purpose (WP4, step 21). Asking is
                 the reversible one: a manager approves it in the portal and the till keeps trading
                 meanwhile. Forgetting is immediate and local, and a till forgotten by mistake needs
                 a fresh enrolment code from somebody who may not be in the building.
                 ⚠ It is NOT styled as destructive, because nothing is destroyed by pressing it. -->
            <Button Text="Ask for this till to be removed" Command="{Binding RequestRemovalCommand}"
                    IsEnabled="{Binding NotBusy}"/>
            <Label FontSize="Micro" Opacity="0.6" LineBreakMode="WordWrap"
                   Text="Asks Plutus to take this till off your estate. A manager approves it in the portal — the till keeps working until they do."/>

            <Button Text="Forget this till" Command="{Binding ForgetCommand}" BackgroundColor="#C1272D" TextColor="White"
                    IsEnabled="{Binding NotBusy}"/>
            <Label FontSize="Micro" Opacity="0.6" LineBreakMode="WordWrap"
                   Text="Clears this device's identity only. Sales already queued on this machine are not deleted."/>

            <!-- ⚠ "This till is out of date" — from the heartbeat (Matt, 2026-08-11: "Does the
                 heartbeat from the till check for updates? All tills should do this").
                 Only visible when this till is genuinely BEHIND the version a platform admin has
                 set, so a correct till shows nothing at all. It is not styled as an error: nothing
                 is broken and selling is unaffected — it is a note for whoever comes to look.
                 ⚠ There is no self-update for MAUI, so this deliberately tells you to fetch the
                 build rather than offering a button that cannot exist. -->
            <Label Margin="0,12,0,0" FontSize="Micro" FontAttributes="Bold" TextColor="{DynamicResource ThemeInk}"
                   LineBreakMode="WordWrap" IsVisible="{Binding HasUpdate}"
                   Text="{Binding UpdateAvailable, StringFormat='⚠ This till is out of date — version {0} is available. Selling is unaffected; ask whoever looks after the tills to install it.'}"/>

            <Label Margin="0,12,0,0" FontSize="Micro" Opacity="0.6" Text="{Binding TillVersionText}"/>
            <Label FontSize="Micro" Opacity="0.6" LineBreakMode="CharacterWrap"
                   Text="{Binding LogPath, StringFormat='Crash log: {0}'}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
