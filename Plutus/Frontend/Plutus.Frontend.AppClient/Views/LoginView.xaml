<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Validators="clr-namespace:Plutus.Frontend.AppClient.Helpers.Validators"
             xmlns:Behaviors="clr-namespace:Plutus.Frontend.AppClient.Behaviors"
             x:Class="Plutus.Frontend.AppClient.Views.LoginView"
             xmlns:i18N="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <ContentPage.Content>
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
            <StackLayout.Behaviors>
                <Behaviors:ValidationGroupBehavior x:Name="form"/>
            </StackLayout.Behaviors>
            <Label Text="{i18N:Translate Login}" FontSize="Medium"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".3*"/>
                    <ColumnDefinition Width=".7*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Text="{i18N:Translate EMail}"/>
                <StackLayout Grid.Column="1" Grid.Row="0">
                    <Entry Placeholder="{Binding Path=Email_UserId_Placeholder, StringFormat={i18N:Translate EnterHere}}" Text="{Binding Email_Userid}">
                        <Entry.Behaviors>
                            <!-- ⚠ EmailValidator REMOVED. The field is labelled "EMail/User Id" and
                                 the login query matches on either — but the validator demanded a
                                 valid email address, so the Submit button stayed GREYED OUT for
                                 anyone signing in with a staff id. The employee-id branch of the
                                 query could never be reached from this screen. -->
                            <Behaviors:ValidationBehavior Group="{x:Reference form}"
                                                          PropertyName="Text">
                                <Behaviors:ValidationBehavior.Validators>
                                    <Validators:RequiredValidator/>
                                </Behaviors:ValidationBehavior.Validators>
                            </Behaviors:ValidationBehavior>
                        </Entry.Behaviors>
                    </Entry>
                </StackLayout>
                <Label Grid.Column="0" Grid.Row="1" Text="{i18N:Translate Password}"/>
                <StackLayout Grid.Column="1" Grid.Row="1">
                    <Entry IsPassword="True"
                           Placeholder="{Binding Source={i18N:Translate Password}, StringFormat={i18N:Translate EnterHere}}" Text="{Binding Password}">
                        <Entry.Behaviors>
                            <!-- ⚠ PasswordValidator REMOVED, and this one was the worst of the two.
                                 It checks password STRENGTH (upper + lower + digit + symbol, 8+),
                                 which belongs where a password is CHOSEN — not where an existing one
                                 is typed. Any account whose password predates that rule could never
                                 sign in: the button simply stayed greyed out, with nothing on screen
                                 saying why. Strength is the portal's business at password-set time. -->
                            <Behaviors:ValidationBehavior Group="{x:Reference form}"
                                                      PropertyName="Text">
                                <Behaviors:ValidationBehavior.Validators>
                                    <Validators:RequiredValidator/>
                                </Behaviors:ValidationBehavior.Validators>
                            </Behaviors:ValidationBehavior>
                        </Entry.Behaviors>
                    </Entry>
                </StackLayout>
            </Grid>
            <Button Text="{i18N:Translate Submit}" Command="{Binding LoginCommand}" IsEnabled="{Binding Source={x:Reference form}, Path=IsValid}"/>

            <!-- WP16a: the connection indicator.
                 Below the sign-in button ON PURPOSE. It is information, not a gate — an operator
                 whose shop is offline must still be able to sign in and sell, so nothing here
                 blocks, disables or delays the button above it. Tap to re-check. -->
            <Grid Margin="0,16,0,0" ColumnSpacing="8" RowSpacing="2">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RefreshConnectionCommand}"/>
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Colour is a hint, never the message: red/amber/green alone is unreadable to
                     the ~8% of men with a colour-vision deficiency, and this text is what tells
                     someone which of three different people to ring. -->
                <Ellipse Grid.Row="0" Grid.Column="0" WidthRequest="10" HeightRequest="10"
                         VerticalOptions="Center" Fill="{Binding ConnectionColour}"/>
                <ActivityIndicator Grid.Row="0" Grid.Column="0" WidthRequest="12" HeightRequest="12"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsCheckingConnection}"
                                   IsRunning="{Binding IsCheckingConnection}"/>
                <Label Grid.Row="0" Grid.Column="1" FontSize="Small" VerticalOptions="Center"
                       Text="{Binding ConnectionSummary}"/>
                <Label Grid.Row="1" Grid.Column="1" FontSize="Micro" Opacity="0.7"
                       Text="{Binding ConnectionDetail}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ConnectionDetail}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <!-- The build under test. Same number as the web till and the backend (till-version.txt),
                 so "I'm on 1.1.0" means one thing across the whole platform. -->
            <Label Margin="0,10,0,0" FontSize="Micro" Opacity="0.6" HorizontalOptions="Center"
                   Text="{Binding TillVersionText}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>