<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:i18n="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             x:Class="Plutus.Frontend.AppClient.Views.MainTill.Loyalty.LoyaltyView"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <!--
        ⚠ THE ROWS ARE BUILT IN CODE, like Cash and Statistics, and deliberately so. MAUI bindings
        fail SILENTLY — a binding to a property that no longer exists renders BLANK and never
        throws — and every row here is somebody's money and somebody's entitlement. A blank tier is
        a customer told they have no discount; a blank balance is credit that looks spent. Built in
        code, a typo is a compile error.

        ⚠ A Grid with an Auto/Auto/* triple, never a StackLayout: MAUI's StackLayout measures
        children to their DESIRED height and does not distribute what is left, so a scrollable list
        inside one collapses to a few rows. That exact mistake shipped on the item list.
    -->
    <Grid RowSpacing="0" Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ⚠ The SERVER search box, distinct from the table's own. This one re-queries Plutus
             (the list is capped server-side); the table's filters what is already on screen. Two
             boxes would confuse, so the table is built without one — see the viewmodel. -->
        <Grid Grid.Row="0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Entry Grid.Column="0"
                   Text="{Binding Search, Mode=TwoWay}"
                   Placeholder="{i18n:Translate SearchMembers}"
                   ReturnCommand="{Binding RefreshCommand}"/>
            <Button Grid.Column="1" Text="{i18n:Translate Search}" Command="{Binding RefreshCommand}"/>

            <!-- ⚠ ADD MEMBER LIVES HERE, NOT ON THE TILL SCREEN (5c items 4 and 6). A member is
                 attached to a sale by SCANNING THEIR CARD - neither the web till nor NatApp has an
                 add button on the sale screen. But when those buttons came off the till screen this
                 tab had none either, so for a few hours MAUI had no way to add a member at all. -->
            <Button Grid.Column="2" Text="{i18n:Translate AddMember}"
                    Command="{Binding AddMemberCommand}"
                    IsVisible="{Binding MayAddCustomers}"/>

            <!-- ⚠ HIDDEN, not disabled, for an operator without customers.manage: a control that
                 refuses everybody who can see it is worse than one that is not there. -->
            <Button Grid.Column="3" Text="{i18n:Translate SetTier}"
                    Command="{Binding SetTierCommand}"
                    IsVisible="{Binding MayManageCustomers}"/>
        </Grid>

        <Label Grid.Row="1" x:Name="StatusLabel" Margin="0,6" />

        <!-- ⚠ The table is added HERE in code (`TillTable`), because it is generic and XAML cannot
             express `TillTable<LoyaltyRowDto>` without a markup extension nobody else needs. -->
        <ContentView Grid.Row="2" x:Name="TableHost"/>
    </Grid>
</ContentPage>
