<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:listViewCM="clr-namespace:Plutus.Frontend.AppClient.Helpers.Extensions.XAML.ListViewWithContextMenu"
             xmlns:Behaviors="clr-namespace:Plutus.Frontend.AppClient.Behaviors"
             xmlns:viewModels="clr-namespace:Plutus.Frontend.AppClient.ViewModels.MainTill.Inventory.Items"
             xmlns:i18n="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             mc:Ignorable="d"
             x:Class="Plutus.Frontend.AppClient.Views.MainTill.Inventory.Items.ViewAllView"
             Title="{Binding Title}">
    <ContentPage.BindingContext>
        <viewModels:ViewAllViewModel/>
    </ContentPage.BindingContext>
    <!--
        ⚠ A GRID, NOT A STACKLAYOUT, AND THAT IS THE WHOLE FIX FOR THE SHORT LIST.

        This was a `StackLayout`, which in MAUI measures each child to its DESIRED height and does
        not distribute what is left over. `VerticalOptions="FillAndExpand"` did that in
        Xamarin.Forms and is effectively a NO-OP in MAUI — one of the quieter differences between
        the two, because nothing warns and the screen still renders. The list asked for a modest
        height, got exactly that, and scrolled 20,000 items inside a ~230px box with the rest of the
        window empty below it.

        `RowDefinition Height="*"` is what actually gives the list the remaining space.
    -->
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <SearchBar Grid.Row="0"
                       Placeholder="{Binding Source={i18n:Translate Items}, StringFormat={i18n:Translate SearchArg}}"
                       Text="{Binding SearchText}"/>
            <listViewCM:ListViewWithContextMenu x:Name="ItemsListView" Grid.Row="1"
                                   ItemsSource="{Binding Items}"
                                   VerticalOptions="Fill" HorizontalOptions="Fill"
                                   LoadMoreOption="AutoOnScroll"
                                   AutoFitMode="DynamicHeight" IsStickyHeader="True" IsStickyGroupHeader="True"
                                   AllowGroupExpandCollapse="True" DataSource="{Binding SfListViewDataSource, Mode=OneWayToSource}">
                <listViewCM:ListViewWithContextMenu.Behaviors>
                    <Behaviors:SfListViewContextMenuBehavior>
                        <Behaviors:SfListViewContextMenuBehavior.Buttons>
                            <Button Text="{i18n:Translate AddToBasket}" HeightRequest="40"
                                    Command="{Binding Path=BindingContext.AddToBasketCommandArg, Source={x:Reference ItemsListView}}"/>
                            <!-- ⚠ EDIT writes to the PLATFORM now (WP10 / step 25, 2026-08-10). It was
                                 hidden earlier the same day because it wrote to the legacy local
                                 database, which nothing reads — the change reached no report, no
                                 other till and no VAT return, and the operator could not even see
                                 it. It now goes through `PUT /api/Item/{id1}`, the same endpoint
                                 the web till uses, with an OPERATOR token.
                                 ⚠ "Update stock" stays hidden: stock is a MOVEMENT LEDGER on the
                                 platform (`POST /api/v1/stock/movements`), not a quantity to
                                 overwrite, and wiring it to the legacy flat column would be the
                                 same mistake in a new place. See `Build/legacy-removal.md` (L2). -->
                            <Button Text="{i18n:Translate Edit}" HeightRequest="40"
                                    Command="{Binding Path=BindingContext.OpenEditItemCommandArg, Source={x:Reference ItemsListView}}"/>
                        </Behaviors:SfListViewContextMenuBehavior.Buttons>
                        <Behaviors:SfListViewContextMenuBehavior.ItemBindings>
                            <x:String>.Id</x:String>
                            <x:String>.Id</x:String>
                            <x:String>.Id</x:String>
                        </Behaviors:SfListViewContextMenuBehavior.ItemBindings>
                    </Behaviors:SfListViewContextMenuBehavior>
                </listViewCM:ListViewWithContextMenu.Behaviors>
                <listViewCM:ListViewWithContextMenu.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".8*"/>
                                <ColumnDefinition Width=".1*"/>
                                <ColumnDefinition Width=".1*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" FontSize="Medium" FontAttributes="Bold" Text="{i18n:Translate Name}"/>
                            <Label Grid.Row="0" Grid.Column="1" FontSize="Medium" FontAttributes="Bold" Text="{i18n:Translate Price}"/>
                            <Label Grid.Row="0" Grid.Column="2" FontSize="Medium" FontAttributes="Bold" Text="{i18n:Translate Stock}"/>
                        </Grid>
                    </DataTemplate>
                </listViewCM:ListViewWithContextMenu.HeaderTemplate>
                <listViewCM:ListViewWithContextMenu.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.View>
                                <Frame CornerRadius="2" Padding="1" Margin="1">
                                    <Frame.HasShadow>
                                        <OnPlatform x:TypeArguments="x:Boolean">
                                            <On Platform="Android, Windows">True</On>
                                            <On Platform="iOS">False</On>
                                        </OnPlatform>
                                    </Frame.HasShadow>
                                    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width=".8*"/>
                                            <ColumnDefinition Width=".1*"/>
                                            <ColumnDefinition Width=".1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat='{0:C}'}"/>
                                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Stock.Quantity}"/>
                                    </Grid>
                                </Frame>
                            </ViewCell.View>
                        </ViewCell>
                    </DataTemplate>
                </listViewCM:ListViewWithContextMenu.ItemTemplate>
            </listViewCM:ListViewWithContextMenu>
        </Grid>
    </ContentPage.Content>
</ContentPage>