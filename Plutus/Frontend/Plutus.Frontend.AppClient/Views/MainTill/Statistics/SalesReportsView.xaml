<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:viewModels="clr-namespace:Plutus.Frontend.AppClient.ViewModels.MainTill.Statistics"
             xmlns:ext="clr-namespace:Plutus.Frontend.AppClient.Helpers.Extensions.XAML"
             xmlns:i18n="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             mc:Ignorable="d"
             x:Class="Plutus.Frontend.AppClient.Views.MainTill.Statistics.SalesReportsView"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <ContentPage.BindingContext>
        <viewModels:SalesReportsViewModel x:Name="_viewModel"/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ext:InverseBoolConverter x:Key="InvertBool"/>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Orientation="Horizontal">
            <!-- ⚠ Two Syncfusion 34.1.32 corrections (2026-08-08): SelectionMode is "Range", not
                 "RangeSelection", and the navigation arrows moved off SfCalendar onto its
                 HeaderView as ShowNavigationArrows. Both threw a XamlParseException at RUNTIME in
                 Debug — this project has no [XamlCompilation(Compile)] attribute, so broken XAML
                 is not a build error here, it is a crash when the screen opens. -->
            <calendar:SfCalendar SelectionMode="Range"
                                 MinimumDate="{Binding CalMinDate}" MaximumDate="{Binding CalMaxDate}"
                                 SelectedDateRange="{Binding CalendarDateRange, Mode=TwoWay}">
                <calendar:SfCalendar.HeaderView>
                    <calendar:CalendarHeaderView ShowNavigationArrows="True"/>
                </calendar:SfCalendar.HeaderView>
            </calendar:SfCalendar>
            <StackLayout HorizontalOptions="FillAndExpand" IsVisible="{Binding TableView, Converter={StaticResource InvertBool}}">
                <chart:SfCartesianChart Series="{Binding Series}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <chart:SfCartesianChart.XAxes>
                        <chart:CategoryAxis/>
                    </chart:SfCartesianChart.XAxes>
                    <chart:SfCartesianChart.YAxes>
                        <chart:NumericalAxis/>
                    </chart:SfCartesianChart.YAxes>
                    <chart:SfCartesianChart.Legend>
                        <chart:ChartLegend/>
                    </chart:SfCartesianChart.Legend>
                    <chart:SfCartesianChart.ZoomPanBehavior>
                        <chart:ChartZoomPanBehavior EnablePinchZooming="True" EnableDoubleTap="True"/>
                    </chart:SfCartesianChart.ZoomPanBehavior>
                    <chart:SfCartesianChart.TooltipBehavior>
                        <chart:ChartTooltipBehavior/>
                    </chart:SfCartesianChart.TooltipBehavior>
                </chart:SfCartesianChart>
                <StackLayout Orientation="Horizontal">
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="{Binding Source={i18n:Translate ExTax}, StringFormat='{0}:'}" FontSize="Medium" FontAttributes="Bold"/>
                        <Label Text="{Binding SalesTotalExTax}" FontSize="Medium"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="{Binding Source={i18n:Translate Tax}, StringFormat='{0}:'}" FontSize="Medium" FontAttributes="Bold"/>
                        <Label Text="{Binding TotalTax}" FontSize="Medium"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="{Binding Source={i18n:Translate Total}, StringFormat='{0}:'}" FontSize="Medium" FontAttributes="Bold"/>
                        <Label Text="{Binding SalesTotal}" FontSize="Medium"/>
                    </StackLayout>
                    <!--<iconize:IconButton Text="md-table-chart" Command="{Binding DisplayTableCommand}" CommandParameter="{x:Reference _gridStack}"/>-->
                </StackLayout>
                <Button Text="{i18n:Translate Export}" Command="{Binding ExportSelectedDataCommand}"/>
            </StackLayout>
            <StackLayout x:Name="_gridStack" HorizontalOptions="FillAndExpand" IsVisible="{Binding TableView}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>