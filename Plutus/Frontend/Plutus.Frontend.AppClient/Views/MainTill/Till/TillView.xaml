<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Plutus.Frontend.AppClient.ViewModels.MainTill.Till"
             xmlns:settings="clr-namespace:Plutus.Frontend.AppClient.ViewModels"
             xmlns:controls="clr-namespace:Plutus.Frontend.AppClient.Controls"
             xmlns:ext="clr-namespace:Plutus.Frontend.AppClient.Helpers.Extensions.XAML"
             xmlns:i18n="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             mc:Ignorable="d"
             x:Class="Plutus.Frontend.AppClient.Views.MainTill.Till.TillView"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <ContentPage.BindingContext>
        <viewModels:TillViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ext:CollectionEmptyBoolConverter x:Key="ListEmptyToBool"/>
        <ext:InverseBoolConverter x:Key="InverseBool"/>
        <ext:StringNullEmptyBoolConverter x:Key="StringNullToBool"/>
        <ResourceDictionary>
            <DataTemplate x:Key="BasketItem">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{i18n:Translate Returns}"
                                  Command="{Binding Path=BindingContext.ReturnCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{i18n:Translate Adjust}"
                                  Command="{Binding Path=BindingContext.AdjustCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='1', StringFormat={i18n:Translate RemoveArg}}"
                                  Command="{Binding Path=BindingContext.RemoveOneCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='all', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Quantity}"
                                               Style="{DynamicResource ListItemTextStyle}"/>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="3" Text="{Binding Tax}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <DataTemplate x:Key="BasketReturnItem">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{Binding Source={i18n:Translate Returns}, StringFormat={i18n:Translate RevertArg}}"
                                  Command="{Binding Path=BindingContext.RevertReturnCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='1', StringFormat={i18n:Translate RemoveArg}}"
                                  Command="{Binding Path=BindingContext.RemoveOneCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='all', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout BackgroundColor="Red">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Quantity}"
                                               Style="{DynamicResource ListItemTextStyle}"/>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="3" Text="{Binding Tax}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <DataTemplate x:Key="BasketNote">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{Binding Source='', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <ext:BasketDataTemplateSelector x:Key="BasketDataTemplateSelector"
                                            BasketItemTemplate="{StaticResource BasketItem}"
                                            BasketItemReturnTemplate="{StaticResource BasketReturnItem}"
                                            BasketNoteTemplate="{StaticResource BasketNote}"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <StackLayout>
                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                    <!-- ⚠ THE QUANTITY BOX, NO LONGER SYNCFUSION. Matt, 2026-08-10: *"I am not
                         going to renew Syncfusion, it seems like it can be replaced."* This was an
                         `SfNumericEntry` and it was the ONLY licensed control on the selling path —
                         a licence the library rejects can start putting a modal in front of the
                         page at any version bump, and this one sits between the operator and every
                         sale.

                         ⚠ `Minimum="1"` went with it, so the clamp now lives in the VIEWMODEL's
                         setter where it cannot leave with a control. A quantity of 0 adds a basket
                         line that charges nothing and looks exactly like a sale.

                         ⚠ Explicit − and + buttons because the Syncfusion spinner had them and a
                         touch till needs them: `Keyboard="Numeric"` shows no keypad on desktop
                         Windows, so without these there is no way to change quantity except typing. -->
                    <Grid ColumnDefinitions="Auto,80,Auto" ColumnSpacing="0">
                        <Button Grid.Column="0" Text="−" WidthRequest="44" Padding="0"
                                Command="{Binding QuantityDownCommand}"/>
                        <Entry Grid.Column="1" x:Name="QuantityEntry"
                               Text="{Binding Quantity, Mode=TwoWay}"
                               Keyboard="Numeric" HorizontalTextAlignment="Center"
                               FontSize="{Binding TopBarFontSize}"
                               TextChanged="Quantity_TextChanged"
                               Unfocused="Quantity_Unfocused"
                               Completed="Quantity_Completed"/>
                        <Button Grid.Column="2" Text="+" WidthRequest="44" Padding="0"
                                Command="{Binding QuantityUpCommand}"/>
                    </Grid>
                    <Button HorizontalOptions="FillAndExpand" Text="{i18n:Translate Scan}" Command="{Binding AutoScanCommand}"
                            IsVisible="{Binding IsDesktop, Mode=OneWay, Converter={StaticResource InverseBool}}"/>
                    <Entry HorizontalOptions="FillAndExpand" Text="{Binding ItemId}"
                           ReturnCommand="{Binding ManualAddCommand}" FontSize="Medium"
                           IsVisible="{Binding IsDesktop, Mode=OneWay}"/>
                    <!-- ⚠⚠ THE VISIBLE DOOR ONTO A REFUND (finding Z1, 2026-08-13). The only way in was
                         a RIGHT-CLICK on a basket line, which nothing on screen advertised — Matt asked
                         where the web till's button was. A feature reachable only by right-click on a
                         touch till is a feature that does not exist, and this one hands money back.
                         ⚠ Beside the scan box on purpose: that is where the web till's is, and where an
                         operator is already looking when a customer puts something on the counter. -->
                    <Button Text="↩ Return an item" Command="{Binding ReturnSelectedCommand}"
                            HorizontalOptions="FillAndExpand"/>
                </StackLayout>
                <ListView x:Name="TillList" VerticalOptions="FillAndExpand" HasUnevenRows="True"
                          ItemsSource="{Binding Basket}" ItemTemplate="{StaticResource BasketDataTemplateSelector}"
                          SelectedItem="{Binding SelectedBasketRecord}" ItemTapped="TillList_ItemTapped">
                    <ListView.Header>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{i18n:Translate Quantity}"/>
                            <Label Grid.Column="1" Text="{i18n:Translate Name}"/>
                            <Label Grid.Column="2" Text="{i18n:Translate Price}"/>
                            <Label Grid.Column="3" Text="{i18n:Translate Tax}"/>
                        </Grid>
                    </ListView.Header>
                </ListView>
                <Grid VerticalOptions="End">
                    <Grid.RowDefinitions>
                        <!-- ⚠ Row 0 is the CUSTOMER BAR (step 27). Rows below shift by one; every
                             Grid.Row in this grid was renumbered with it. MAUI bindings fail
                             SILENTLY, so a missed one renders blank rather than erroring. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ⚠ THE CUSTOMER BAR. "Add member" when nobody is attached; the member's name
                         and tier when one is, with a button to take them off again. The two swap on
                         HasAttachedCustomer so the operator always has exactly one of them. -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Text="{i18n:Translate Search}"
                            IsVisible="{Binding HasAttachedCustomer, Converter={StaticResource InverseBool}}"
                            Command="{Binding AttachCustomerCommand}"/>
                    <!-- ⚠ Hidden when the operator lacks `pos.customers.add` OR `customers.manage`.
                         A control that is only going to refuse is worse than no control. -->
                    <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                            Text="{i18n:Translate AddMember}"
                            IsVisible="{Binding MayAddCustomers}"
                            Command="{Binding AddMemberCommand}"/>
                    <Label  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalOptions="Center"
                            IsVisible="{Binding HasAttachedCustomer}"
                            Text="{Binding AttachedCustomerLabel}"/>
                    <!-- ⚠ Supervisor and up (`customers.manage`) — a tier changes every future
                         basket that customer puts through, so it is not a cashier's decision. -->
                    <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1"
                            Text="{i18n:Translate SetTier}"
                            IsVisible="{Binding MayManageCustomers}"
                            Command="{Binding SetTierCommand}"/>
                    <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                            Text="{i18n:Translate RemoveMember}"
                            IsVisible="{Binding HasAttachedCustomer}"
                            Command="{Binding DetachCustomerCommand}"/>

                    <Label  Grid.Row="1" Grid.Column="0" Text="{i18n:Translate SaleExTax}"/>
                    <Label  Grid.Row="1" Grid.Column="1" Text="{Binding SaleExTax, StringFormat='{0:C2}'}"/>
                    <Label  Grid.Row="1" Grid.Column="4" Text="{i18n:Translate SaleIncTax}"/>
                    <Label  Grid.Row="1" Grid.Column="5" Text="{Binding SaleIncTax, StringFormat='{0:C2}'}"/>
                    <Button Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Text="{i18n:Translate AltTransaction}"
                            Command="{Binding AlterTransactionSelectorCommand}"/>
                    <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{i18n:Translate Bag}"
                            IsVisible="{Binding DefaultBagId, Mode=OneWay, Converter={StaticResource StringNullToBool}}"
                            Command="{Binding ManualAddCommandArg}" CommandParameter="{Binding DefaultBagId}"/>
                    <Button Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Text="{i18n:Translate StoreTransaction}"
                            Command="{Binding StoreTransactionCommand}"/>
                    <Button Grid.Row="2" Grid.Column="5" Grid.RowSpan="2" Text="{i18n:Translate CheckoutTransaction}"
                            Command="{Binding CheckoutTransactionCommand}"/>
                    <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                            Text="{i18n:Translate CancelTransaction}" Command="{Binding CancelTransactionCommand}"/>
                </Grid>
            </StackLayout>
            <!-- ⚠ THE ALTERATIONS PICKER IS GONE FROM THE XAML — it is now a `DisplayActionSheet`,
                 raised from `TillViewModel.AlterTransactionSelectorCommand`.

                 Matt, 2026-08-10: *"I am not going to renew Syncfusion."* This was an `SfPicker`,
                 and it had already cost a session on its own: the columns were wrapped in
                 `PickerColumnCollection`, a type that does NOT exist in Syncfusion 34.1.32, and
                 because this project has no [XamlCompilation(Compile)] attribute, DEBUG parsed the
                 XAML at runtime and threw the moment the Till tab was constructed. Release caught
                 it at build time; Debug turned it into a crash on the shop floor.

                 An action sheet cannot fail that way — there is no markup to get wrong — and this
                 app already uses one for tenders, item search and refund origins, so it is the
                 control operators here already know. -->
            <!--Alterations selection Picker: now an action sheet, see TillViewModel-->
        </Grid>
    </ContentPage.Content>
</ContentPage>