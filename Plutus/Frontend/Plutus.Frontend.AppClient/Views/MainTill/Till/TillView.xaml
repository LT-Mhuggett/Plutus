<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Plutus.Frontend.AppClient.ViewModels.MainTill.Till"
             xmlns:settings="clr-namespace:Plutus.Frontend.AppClient.ViewModels"
             xmlns:controls="clr-namespace:Plutus.Frontend.AppClient.Controls"
             xmlns:ext="clr-namespace:Plutus.Frontend.AppClient.Helpers.Extensions.XAML"
             xmlns:i18n="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             mc:Ignorable="d"
             x:Class="Plutus.Frontend.AppClient.Views.MainTill.Till.TillView"
             x:Name="TillPage"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}"
             BackgroundColor="{DynamicResource ThemeSurface}">
    <ContentPage.BindingContext>
        <viewModels:TillViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ext:CollectionEmptyBoolConverter x:Key="ListEmptyToBool"/>
        <ext:InverseBoolConverter x:Key="InverseBool"/>
        <ext:StringNullEmptyBoolConverter x:Key="StringNullToBool"/>
        <!-- ⚠ "Bag £0.10" — the web till's exact wording, under the 2026-08-19 look-and-feel ruling. -->
        <ext:PenceToBagLabelConverter x:Key="PenceToBagLabel"/>
        <ResourceDictionary>
            <DataTemplate x:Key="BasketItem">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{i18n:Translate Returns}"
                                  Command="{Binding Path=BindingContext.ReturnCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{i18n:Translate Adjust}"
                                  Command="{Binding Path=BindingContext.AdjustCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='1', StringFormat={i18n:Translate RemoveArg}}"
                                  Command="{Binding Path=BindingContext.RemoveOneCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='all', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Quantity}"
                                               Style="{DynamicResource ListItemTextStyle}"/>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <!--
                                ⚠⚠ THE PRICE IS THE WAY IN (5c item 3). Matt, 2026-08-18:
                                *"Click the price in the row to adjust it"*, which is exactly what the
                                web till does - its price cell is a `linklike` BUTTON that opens an
                                editor. On MAUI, Adjust existed ONLY on the right-click / long-press
                                context menu, with nothing on screen to say so. That is the same
                                discoverability fault already reported once about editing an item:
                                *"I didn't know how to open it"* (2026-08-10).

                                ⚠ THE LABEL AND ITS BINDING ARE UNTOUCHED, deliberately. The gesture
                                goes on a wrapper, so if a `TapGestureRecognizer` inside a `ViewCell`
                                turns out not to fire on WinUI, the price still renders exactly as it
                                does today and only the new affordance is missing - the context menu is
                                still there. ⚠ A Button here would have been closer to the web till,
                                and was rejected: its `TextColor` would need to resolve from the theme,
                                and a price that renders invisible on the money screen is the fault
                                that cost build 1.74.0. **Feature-absent beats price-invisible.**
                                ⚠⚠ So whether the tap fires is UNVERIFIED BY MACHINE - `Test Maui.md`
                                G42 is the only check.
                            -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="2">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.AdjustCommandArg, Source={x:Reference Name=TillList}}"
                                        CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Price, StringFormat='{0:C}'}"
                                                   Style="{DynamicResource ListItemDetailTextStyle}"/>
                                <!-- ⚠ THE MARKER, and it is money-visibility rather than decoration -
                                     see `BasketItem.Adjusted`. A separate label on purpose: if THIS
                                     binding fails the asterisk is missing, whereas folding it into the
                                     price's own binding would blank the price. -->
                                <Label Text="*" IsVisible="{Binding Adjusted}"
                                                   Style="{DynamicResource ListItemDetailTextStyle}"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="3" Text="{Binding Tax}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <DataTemplate x:Key="BasketReturnItem">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{Binding Source={i18n:Translate Returns}, StringFormat={i18n:Translate RevertArg}}"
                                  Command="{Binding Path=BindingContext.RevertReturnCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='1', StringFormat={i18n:Translate RemoveArg}}"
                                  Command="{Binding Path=BindingContext.RemoveOneCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                        <MenuItem Text="{Binding Source='all', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout BackgroundColor="Red">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Quantity}"
                                               Style="{DynamicResource ListItemTextStyle}"/>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="3" Text="{Binding Tax}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <DataTemplate x:Key="BasketNote">
                <ViewCell>
                    <ViewCell.ContextActions>
                        <MenuItem Text="{Binding Source='', StringFormat={i18n:Translate RemoveArg}}" IsDestructive="True"
                                  Command="{Binding Path=BindingContext.RemoveAllCommandArg, Source={x:Reference Name=TillList}}" CommandParameter="{Binding .}"/>
                    </ViewCell.ContextActions>
                    <StackLayout>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}"
                                               Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </Grid>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>
            <ext:BasketDataTemplateSelector x:Key="BasketDataTemplateSelector"
                                            BasketItemTemplate="{StaticResource BasketItem}"
                                            BasketItemReturnTemplate="{StaticResource BasketReturnItem}"
                                            BasketNoteTemplate="{StaticResource BasketNote}"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <!-- ⚠⚠ A GRID WITH A STAR ROW, NOT A StackLayout (Matt, 2026-08-20: "if you add many
                 items, the buttons 'Checkout etc' go off the bottom of the screen"). A vertical
                 StackLayout measures children UNBOUNDED, so the basket ListView grew to its content
                 and pushed the totals + checkout grid off-screen — the operator could not pay a long
                 basket out without scrolling blind. Row 2 (*) bounds the list so it scrolls INSIDE
                 itself; rows 0/1/3 (Auto) keep the noticeboard, scan row and buttons always visible.
                 The web till got the same rule the same day (.shell.till-locked in index.css). -->
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- ⚠⚠ THE NOTICEBOARD (WP5b) — pick-from-floor notes and platform announcements.
                     The web till has had this since Phase 6; MAUI had the shared rules
                     (`Client.Core.NoticesClient`, 23 tests) and no caller and no banner.

                     ⚠ AT THE TOP OF THE SELLING SCREEN, because that is the only page an operator
                     is guaranteed to be looking at. A notice on the Plutus tab is a notice nobody
                     reads — the pick note exists to stop a web order being oversold, which is a
                     race against somebody else selling the last one off the shelf.

                     ⚠ THE WHOLE THING COLLAPSES when there is nothing to say. A permanent empty
                     strip costs the pixels for good and trains people not to look at that region.

                     ⚠ Announcements first, then pick notes — see `NoticeboardViewModel.Redraw`. -->
                <StackLayout Grid.Row="0" IsVisible="{Binding Notices.HasAnything}" Margin="0,0,0,6" Spacing="4">
                    <CollectionView ItemsSource="{Binding Notices.Rows}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" Margin="0,2" StrokeThickness="0"
                                        BackgroundColor="{Binding Accent}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="{Binding Headline}" FontAttributes="Bold"
                                                   TextColor="White" LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding Detail}" FontSize="Small"
                                                   TextColor="White" LineBreakMode="WordWrap"/>
                                        </StackLayout>
                                        <!-- ⚠ HIDDEN, not disabled, on an announcement: those cannot be
                                             acknowledged at all, and a greyed-out button invites
                                             somebody to keep pressing it.
                                             ⚠ The command lives on the PAGE's viewmodel, not the row,
                                             so it is reached by name through the CollectionView. -->
                                        <Button Grid.Column="1" Text="{i18n:Translate Done}"
                                                IsVisible="{Binding CanAck}" Padding="12,4"
                                                VerticalOptions="Center"
                                                Command="{Binding Path=BindingContext.Notices.AckCommand, Source={x:Reference Name=TillPage}}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <!-- ⚠ ONLY ALONGSIDE SOMETHING. "This may be out of date" over an empty board is
                         a warning about nothing, every time a shop's line drops. -->
                    <Label IsVisible="{Binding Notices.ShowStale}" FontSize="Micro" Opacity="0.7"
                           Text="⚠ Plutus can't be reached — these notices may be out of date."/>
                </StackLayout>

                <StackLayout Grid.Row="1" Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                    <!-- ⚠ THE QUANTITY BOX, NO LONGER SYNCFUSION. Matt, 2026-08-10: *"I am not
                         going to renew Syncfusion, it seems like it can be replaced."* This was an
                         `SfNumericEntry` and it was the ONLY licensed control on the selling path —
                         a licence the library rejects can start putting a modal in front of the
                         page at any version bump, and this one sits between the operator and every
                         sale.

                         ⚠ `Minimum="1"` went with it, so the clamp now lives in the VIEWMODEL's
                         setter where it cannot leave with a control. A quantity of 0 adds a basket
                         line that charges nothing and looks exactly like a sale.

                         ⚠ Explicit − and + buttons because the Syncfusion spinner had them and a
                         touch till needs them: `Keyboard="Numeric"` shows no keypad on desktop
                         Windows, so without these there is no way to change quantity except typing. -->
                    <Grid ColumnDefinitions="Auto,80,Auto" ColumnSpacing="0">
                        <Button Grid.Column="0" Text="−" WidthRequest="44" Padding="0"
                                Command="{Binding QuantityDownCommand}"/>
                        <Entry Grid.Column="1" x:Name="QuantityEntry"
                               Text="{Binding Quantity, Mode=TwoWay}"
                               Keyboard="Numeric" HorizontalTextAlignment="Center"
                               FontSize="{Binding TopBarFontSize}"
                               TextChanged="Quantity_TextChanged"
                               Unfocused="Quantity_Unfocused"
                               Completed="Quantity_Completed"/>
                        <Button Grid.Column="2" Text="+" WidthRequest="44" Padding="0"
                                Command="{Binding QuantityUpCommand}"/>
                    </Grid>
                    <Button HorizontalOptions="FillAndExpand" Text="{i18n:Translate Scan}" Command="{Binding AutoScanCommand}"
                            IsVisible="{Binding IsDesktop, Mode=OneWay, Converter={StaticResource InverseBool}}"/>
                    <Entry HorizontalOptions="FillAndExpand" Text="{Binding ItemId}"
                           ReturnCommand="{Binding ManualAddCommand}" FontSize="Medium"
                           IsVisible="{Binding IsDesktop, Mode=OneWay}"/>
                    <!-- ⚠⚠ THE BAG BUTTONS MOVED UP HERE, 2026-08-21. Matt: *"Can the bag button in
                         MAUI be moved up the top like on the webtill please."* They sat in the bottom
                         action grid among Alter / Save / Retrieve / Checkout / Cancel; the web till has
                         had them in the SCAN ROW beside the Return button since it was written.

                         ⚠ The 2026-08-19 look-and-feel ruling: an operator who moves between tills
                         mid-shift must not have to hunt. The old comment on this block conceded
                         *"position still differs — the two checkout layouts are reconciled by §5c item
                         2, not here"* — that deferral is now closed.

                         ⚠⚠ AND THE POSITION IS THE RIGHT ONE ON ITS OWN MERITS. A bag is scanned-in
                         goods, not a checkout decision: it is added WHILE ringing items through, so it
                         belongs with the scan box, not beside Checkout where it reads as a payment
                         step. That is also why it sits before Return — the two things an operator adds
                         to a basket by hand, together.

                         ⚠ ONE BUTTON PER BAG, cheapest first, each labelled with its price (ruling
                         2026-08-19). This was a single "Bag" button bound to `DefaultBagId` — one
                         barcode, free text, held per device — so a shop selling a single-use bag AND a
                         bag for life could only offer one, and this till held "001", a barcode no item
                         had. The list comes from the portal; see `Services.Sales.CarrierBags`.
                         ⚠ MATCHES THE WEB TILL'S LABEL exactly ("Bag £0.10").
                         ⚠ A HorizontalStackLayout, not grid cells: the number of bags is the shop's
                         decision and a fixed grid cannot hold an unknown count. -->
                    <HorizontalStackLayout Spacing="4"
                                           BindableLayout.ItemsSource="{Binding CarrierBags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <!-- ⚠ The price is formatted here rather than stored formatted, so it
                                     follows the till's culture like every other figure on the screen. -->
                                <Button Text="{Binding PricePence, Converter={StaticResource PenceToBagLabel}}"
                                        Command="{Binding Path=BindingContext.AddBagCommand, Source={x:Reference Name=TillPage}}"
                                        CommandParameter="{Binding .}"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <!-- ⚠⚠ THE VISIBLE DOOR ONTO A REFUND (finding Z1, 2026-08-13). The only way in was
                         a RIGHT-CLICK on a basket line, which nothing on screen advertised — Matt asked
                         where the web till's button was. A feature reachable only by right-click on a
                         touch till is a feature that does not exist, and this one hands money back.
                         ⚠ Beside the scan box on purpose: that is where the web till's is, and where an
                         operator is already looking when a customer puts something on the counter. -->
                    <Button Text="↩ Return an item" Command="{Binding ReturnSelectedCommand}"
                            HorizontalOptions="FillAndExpand"/>
                </StackLayout>
                <!-- ⚠ Grid.Row="2" is the star row — the ONLY thing on this screen allowed to give
                     up height. The list scrolls; the buttons below never move.

                     ⚠⚠ `VerticalScrollBarVisibility="Always"` IS FOR PARITY, NOT DECORATION. WinUI
                     auto-hides scrollbars by convention: the list scrolled correctly without this, but
                     the bar only appeared once you were already scrolling — so an operator looking at a
                     full basket had nothing telling them there was more below. The web till draws its
                     bar whenever the basket overflows (and reserves the gutter so prices never shift),
                     and Matt asked for "a scroll bar" on BOTH tills. Under the 2026-08-19 look-and-feel
                     ruling an operator swapping tills mid-shift must not have to learn that one of them
                     hides the thing that says "there is more". -->
                <ListView x:Name="TillList" Grid.Row="2" HasUnevenRows="True"
                          VerticalScrollBarVisibility="Always"
                          ItemsSource="{Binding Basket}" ItemTemplate="{StaticResource BasketDataTemplateSelector}"
                          SelectedItem="{Binding SelectedBasketRecord}" ItemTapped="TillList_ItemTapped">
                    <ListView.Header>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{i18n:Translate Quantity}"/>
                            <Label Grid.Column="1" Text="{i18n:Translate Name}"/>
                            <Label Grid.Column="2" Text="{i18n:Translate Price}"/>
                            <Label Grid.Column="3" Text="{i18n:Translate Tax}"/>
                        </Grid>
                    </ListView.Header>
                </ListView>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <!-- ⚠ Row 0 is the CUSTOMER BAR (step 27). Rows below shift by one; every
                             Grid.Row in this grid was renumbered with it. MAUI bindings fail
                             SILENTLY, so a missed one renders blank rather than erroring. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ⚠⚠ THE CUSTOMER SEARCH AND "ADD MEMBER" BUTTONS ARE GONE (2026-08-18).
                         Matt, twice: *"Why is search and add member on the till screen? Neither the
                         webtill or original NatApp has this here. It should not be there."*

                         ⚠ I argued once that they belonged, and I was wrong on the facts. Verified
                         against the web till: its till screen has NO customer control at all — a
                         member is attached by SCANNING THEIR CARD, which `MEMBER_CARD` picks up in
                         the scan handler. MAUI has the same path (`MemberNumbers.LooksLikeMemberScan`,
                         TillViewModel ~1648), so nothing is lost by removing the buttons: the
                         scan still attaches, and the members' auto-discount still applies.

                         ⚠ Adding and editing members belongs on the LOYALTY tab — see
                         `MAUI-retrofit.md` §5c item 6. The commands stay on the view model because
                         that tab will call them.

                         What remains here is the ATTACHED-CUSTOMER row: who is on this sale, their
                         tier, and a way to take them off again. That is about the basket in front of
                         the operator, not about managing the loyalty scheme. -->
                    <Label  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" VerticalOptions="Center"
                            IsVisible="{Binding HasAttachedCustomer}"
                            Text="{Binding AttachedCustomerLabel}"/>
                    <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                            Text="{i18n:Translate RemoveMember}"
                            IsVisible="{Binding HasAttachedCustomer}"
                            Command="{Binding DetachCustomerCommand}"/>

                    <!-- ⚠⚠ THE LOOKUP IS BACK, AND THE LABEL IS THE WHOLE POINT (2026-08-19).
                         Matt: *"It was on the till screen where it didnt make sense. I asked you to
                         remove them from the till screen because +Add member didnt make sense. It
                         implied that it was to add a new member. It needs to be more obvious what that
                         button was for, which is why I suggested 'Loyalty Customer Lookup'."*

                         ⚠ So the 2026-08-18 removal was an OVER-CORRECTION: his objection was the
                         WORDING, and I deleted the function. The comment above — *"I argued once that
                         they belonged, and I was wrong on the facts"* — was itself wrong, and the cost
                         was real: attaching a member became scan-only, which is what stranded §G50a
                         and §G53a when a card could not be scanned.

                         ⚠ ONE button, not two. "Add member" belongs on the LOYALTY tab and stays
                         there; this one only FINDS an existing member, which is what the label now
                         says. `ExecuteAttachCustomer` already searched by name, phone, email OR member
                         number — it was never rebuilt, only unbound. -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Text="Loyalty customer lookup"
                            IsVisible="{Binding HasNoAttachedCustomer}"
                            Command="{Binding AttachCustomerCommand}"/>

                    <Label  Grid.Row="1" Grid.Column="0" Text="{i18n:Translate SaleExTax}"/>
                    <Label  Grid.Row="1" Grid.Column="1" Text="{Binding SaleExTax, StringFormat='{0:C2}'}"/>
                    <Label  Grid.Row="1" Grid.Column="4" Text="{i18n:Translate SaleIncTax}"/>
                    <Label  Grid.Row="1" Grid.Column="5" Text="{Binding SaleIncTax, StringFormat='{0:C2}'}"/>
                    <Button Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Text="{i18n:Translate AltTransaction}"
                            Command="{Binding AlterTransactionSelectorCommand}"/>
                    <!-- ⚠⚠ THE BAG BUTTONS ARE NOT HERE ANY MORE (2026-08-21). Matt: *"Can the bag
                         button in MAUI be moved up the top like on the webtill please."* They are in
                         the SCAN ROW now, beside Return, which is where the web till has always had
                         them — see the block up there for why that is also the better place.

                         ⚠ COLUMNS 1 AND 2 ARE NOW FREE ON THIS ROW, and they are deliberately left
                         empty rather than closed up. This grid's columns are shared with rows 1 and 3
                         (the totals, and Cancel spanning 1–4); narrowing them to absorb the gap would
                         move the totals, which are the two figures an operator checks against a
                         customer's screen. -->
                    <!-- ⚠⚠ SAVE **AND** RETRIEVE, side by side (2026-08-18). Retrieve was a toolbar
                         item labelled "Baskets" that appeared and disappeared with the parked list —
                         so the feature worked and nobody could find it. Matt asked for two buttons
                         with Retrieve disabled when there is nothing, which is both clearer and safer:
                         the old path called `.First()` on an empty collection. -->
                    <Button Grid.Row="2" Grid.Column="3" Text="{i18n:Translate StoreTransaction}"
                            Command="{Binding StoreTransactionCommand}"/>
                    <Button Grid.Row="2" Grid.Column="4" Text="{i18n:Translate RetrieveTransaction}"
                            IsEnabled="{Binding HasStoredTransactions}"
                            Command="{Binding RetrieveTransactionCommand}"/>
                    <Button Grid.Row="2" Grid.Column="5" Grid.RowSpan="2" Text="{i18n:Translate CheckoutTransaction}"
                            Command="{Binding CheckoutTransactionCommand}"/>
                    <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                            Text="{i18n:Translate CancelTransaction}" Command="{Binding CancelTransactionCommand}"/>
                </Grid>
            </Grid>
            <!-- ⚠ THE ALTERATIONS PICKER IS GONE FROM THE XAML — it is now a `DisplayActionSheet`,
                 raised from `TillViewModel.AlterTransactionSelectorCommand`.

                 Matt, 2026-08-10: *"I am not going to renew Syncfusion."* This was an `SfPicker`,
                 and it had already cost a session on its own: the columns were wrapped in
                 `PickerColumnCollection`, a type that does NOT exist in Syncfusion 34.1.32, and
                 because this project has no [XamlCompilation(Compile)] attribute, DEBUG parsed the
                 XAML at runtime and threw the moment the Till tab was constructed. Release caught
                 it at build time; Debug turned it into a crash on the shop floor.

                 An action sheet cannot fail that way — there is no markup to get wrong — and this
                 app already uses one for tenders, item search and refund origins, so it is the
                 control operators here already know. -->
            <!--Alterations selection Picker: now an action sheet, see TillViewModel-->
        </Grid>
    </ContentPage.Content>
</ContentPage>