<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Plutus.Frontend.AppClient.ViewModels.FirstTimeStartUp"
             x:Class="Plutus.Frontend.AppClient.Views.FirstTimeStartUp.RecoveryView"
             xmlns:i18N="clr-namespace:I18N_L10N.Extensions;assembly=I18N_L10N"
             Title="{Binding Title}"
             IconImageSource="{Binding Icon, Converter={StaticResource MaterialIconConverter}}">
    <ContentPage.BindingContext>
        <viewModels:RecoveryViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout>
            <ScrollView VerticalOptions="FillAndExpand">
                <Grid Margin="5,0,5,50">
                    <!--Grid Definitions-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--End of Grid Definitions-->

                    <!--Title of Page-->
                    <Label Grid.Column="0" Grid.Row="0" Text="{Binding Title}" TextColor="{DynamicResource ThemeInkMuted}" FontSize="Large"/>
                    <!--End of Title of Page-->

                    <!--Left data column-->
                    <StackLayout x:Name="LeftDataColumn" Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" VerticalOptions="Center" HorizontalOptions="FillAndExpand" >
                        <Button Text="{i18N:Translate RecoverDB}" Command="{Binding RecoverDbCommand}"/>
                    </StackLayout>
                    <!--End of Left data column-->

                    <!--Center column-->
                    <StackLayout x:Name="CenterColumn" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" VerticalOptions="Center" >
                        <BoxView HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="100" WidthRequest="1" Opacity=".5" Color="{DynamicResource ThemeLine}"/>
                    </StackLayout>
                    <!--End of Center column-->

                    <!--Right data column-->
                    <!-- ⚠ WAS A DEAD FORM. An email box, a password box and a Submit button with NO
                         Command, no handler and no bindings on either entry — pressing it did
                         literally nothing, for ever, with no way for anyone to tell. A control that
                         cannot work is worse than an absent one: it costs somebody the time to try
                         it, twice, before they believe it.

                         Account recovery belongs in the PORTAL now (portal-first, 2026-08-08), so
                         this says where to go instead of pretending. -->
                    <StackLayout x:Name="RightDataColumn" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Spacing="8">
                        <Label Text="Forgotten your password?" FontAttributes="Bold"/>
                        <Label FontSize="Caption" LineBreakMode="WordWrap"
                               Text="Passwords are reset in the Plutus portal, by someone with staff-admin access — not on the till. Ask a manager to set you a new one, then sign in as usual."/>
                    </StackLayout>
                    <!--End of Right data column-->
                </Grid>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>