<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Plutus.Frontend.AppClient.Views.CustomViews.SliderAlert">
  <ContentView.Content>
        <StackLayout x:Name="StackContainer" Padding="20"
                BackgroundColor="{DynamicResource ThemeSurface}"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="CenterAndExpand">
            <ScrollView>
                <StackLayout x:Name="MainLayout"/>
            </ScrollView>
        </StackLayout>
    </ContentView.Content>
</ContentView>