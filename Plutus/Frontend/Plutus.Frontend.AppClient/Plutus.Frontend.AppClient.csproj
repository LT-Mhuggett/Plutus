<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Plutus.Frontend.AppClient</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <LangVersion>10.0</LangVersion>

    <!-- ⚠ THE TILL IS ENGLISH-ONLY, so ship no satellite resource assemblies (2026-08-20). Matt asked
         why the publish folder held 119 language subfolders; 35 of them were managed satellites for
         framework strings this app never shows, and this one property removes all of them.

         ⚠⚠ CHECKED BEFORE SETTING IT, because it would have been wrong if the till's own translations
         lived there. They don't: `Plutus/Shared/I18N_L10N` has a SINGLE `Resx/AppResources.resx`
         declared `<EmbeddedResource>`, so it compiles into the assembly and there is no
         `I18N_L10N.resources.dll` in the output at all. `.Translate()` does not use satellites.

         ⚠ IT DOES NOT TOUCH THE OTHER ~84 FOLDERS, and nothing supported does. Those hold native Win32
         `.mui` resources shipped as content by the Windows App SDK; they appear NOWHERE in
         `deps.json` and the MUI loader probes `<dll's own directory>\<culture>\`. They cannot be moved
         into a `languages/` folder either — for the same reason. 3.8 MB, left alone deliberately. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Preserves the platform minimums the Xamarin.Forms heads previously targeted. -->
    <AndroidMinimumVersion>21</AndroidMinimumVersion>
    <IOSMinimumVersion>8.0</IOSMinimumVersion>

    <ApplicationTitle>Plutus</ApplicationTitle>
    <ApplicationId>com.MBH.NatApp.Plutus</ApplicationId>
    <!-- THIS TILL's version, separate from the web till's on purpose: they will diverge the first
         time a Windows-only printer or drawer problem needs fixing here and nowhere else.
         ApplicationDisplayVersion is set from it by Directory.Build.targets. -->
    <PlutusVersionFile>versions/till-maui.txt</PlutusVersionFile>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">8.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- ⚠ WHY THIS EXISTS: Debug used to accept XAML that cannot possibly work.
       MAUI defaults the inflator to Runtime in Debug and XamlC in Release
       (Microsoft.Maui.Controls.targets), so in Debug nothing checked XAML until the page was
       actually opened - a bad property or a Syncfusion type that doesn't exist built clean and
       threw XamlParseException in front of whoever tapped the tab. That is exactly how three
       faults reached a hand-test on 2026-08-08.

       Proven by mutation, not assumed: with `ThisPropertyDoesNotExist="42"` on a Label, Debug
       reported 0 errors and Release reported XC0009. With this property set, Debug reports it too.

       This does NOT change what the app does at runtime. Debug still forces ValidateOnly=true
       (see the XamlC target), so XamlCTask only inspects the assembly - it does not rewrite IL -
       and _MauiXaml_AsEmbeddedResource still embeds the XAML, so pages are still inflated at
       runtime exactly as before. It buys the error message, and nothing else.

       Revert by deleting this PropertyGroup if XAML Hot Reload ever misbehaves. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <MauiXamlInflator>XamlC</MauiXamlInflator>
    <!-- MAUI1001 is the SDK warning that setting an inflator explicitly costs XAML Hot Reload. It
         is aimed at people who set XamlC without meaning to; here it is the whole point, and the
         warning would otherwise print on every single Debug build until it became invisible - at
         which point it would be hiding whatever real warning appeared next to it. -->
    <NoWarn>$(NoWarn);MAUI1001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Debug'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' != 'Debug'">
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <!-- Prints OTel log records/spans to the debug console so telemetry can be eyeballed locally
         without needing NEW_RELIC_LICENSE_KEY set or a live New Relic connection. -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />

    <!-- Loads a local, gitignored .env file (see MauiProgram.cs) so secrets like
         NEW_RELIC_LICENSE_KEY can be set for local dev without a real environment variable. -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: the Plutus mark, SHARED with the web till and portal (their public/icon.svg is
         the same tile + glyph) — Matt, 2026-08-09: one product, one icon, on all three surfaces.
         Replaced the legacy NatApp indigo (#3F51B5) mipmap PNGs. ForegroundScale keeps the P
         inside Android's adaptive-icon safe zone; Color is the fallback behind the glyph. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#2c698d" />

    <!-- Splash: same glyph on the same brand blue, so launch doesn't flash a different product. -->
    <MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#2c698d" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts (carried over from Xam.Plugin.Iconize.FontAwesome/.Material) -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw assets read at runtime via FileSystem.OpenAppPackageFileAsync (e.g. appsettings.json). -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="Mopups" Version="1.3.2" />
    <PackageReference Include="Plugin.Maui.MessagingCenter" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.Extended" Version="2.0.0" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />

    <!-- ⚠⚠ ALL TEN SYNCFUSION PACKAGES AND `DocumentFormat.OpenXml` CAME OUT ON 2026-08-20, together
         with the two legacy report screens and the Excel export they served. That is ~91 MB — 35% of
         a 264 MB publish — serving screens no operator could open.

         ⚠ WHY IT WAS FINALLY POSSIBLE: L4's ruling kept them because those screens were "the only
         reader of a migrated till's local pre-cutover file". They no longer are — the NatApp full
         replace (2026-08-20) put 21,914 sales going back to 2019-01-23 into the platform, so the
         portal answers what they used to, from data that also covers everything sold since cutover.

         ⚠⚠ DO NOT ADD ANY OF THESE BACK. **No Syncfusion key is coming** (Matt, 2026-08-10), keys are
         version-specific, and an unlicensed control does not fail the build — it puts a modal in front
         of a shop-floor screen. `SatelliteResourceLanguages` below is set partly because these were the
         only remaining source of satellite resource folders.

         ⚠ `DocumentFormat.OpenXml` was NOT the "one line, nothing references it" change the old
         `Shrink MAUI Build.md` §3 claimed — that grep was wrong. `Helpers/FileIO/ExcelHandling.cs` was
         built on `SpreadsheetDocument`, so it had to go with the screen that called it. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project set internal test-only bootstrap state (e.g. App.TranslateExtension)
         without changing production visibility or behavior. -->
    <InternalsVisibleTo Include="Plutus.Frontend.AppClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAUI retrofit WP16: the till's shared half. These three are plain net10.0 with no packages
         and no MAUI (held by two architecture tests), so referencing them adds nothing to the app
         bundle but the rules themselves. ⚠ The direction matters: MAUI may reference these; they
         may never reference MAUI, or a macOS/Linux till stops being a build target. -->
    <ProjectReference Include="..\..\..\src\Plutus.SharedKernel\Plutus.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\src\Plutus.Contracts.Client\Plutus.Contracts.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Plutus.Client.Core\Plutus.Client.Core.csproj" />
    <!-- The v2 local store. Added 2026-08-09 with binding default 9 ("no bridge to the legacy
         database"): the screens read their catalogue, prices and sales from HERE from now on, and
         Plutus/Data/Database retires screen by screen.
         ⚠ This reference is what forced the whole app onto EF Core 9 — see Database.csproj. -->
    <ProjectReference Include="..\..\..\src\Plutus.Client.Storage\Plutus.Client.Storage.csproj" />
    <ProjectReference Include="..\..\Shared\CommonPOSLibrary\CommonPOSLibrary.csproj" />
    <ProjectReference Include="..\..\Shared\CustomViews\CustomViews.csproj" />
    <ProjectReference Include="..\..\Data\Database\Database.csproj" />
    <ProjectReference Include="..\..\Shared\I18N_L10N\I18N_L10N.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\MainTill\Inventory\Items\ViewAllView.xaml.cs">
      <DependentUpon>ViewAllView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainTill\Statistics\StockOuttakeView.xaml.cs">
      <DependentUpon>StockOuttakeView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainTill\StoreOptions\StoreOptionsView.xaml.cs">
      <DependentUpon>StoreOptionsView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
