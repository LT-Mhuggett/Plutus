<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xamlHelpers="clr-namespace:Plutus.Frontend.AppClient.Helpers.Extensions.XAML"
             x:Class="Plutus.Frontend.AppClient.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Step 22 / 7a — the palette, ported from ClientUI before that project is dropped
                 ([L10]). ⚠ Merged rather than inlined so `Theming.Apply` can find the seven
                 `Theme*` keys by name at runtime and overwrite only those. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <!-- ⚠ AFTER Colors, because these styles reference the seven `Theme*` keys it defines.
                     ⚠⚠ And this dictionary is where MAUI first CONSUMES a theme slot: two of its styles
                     were referenced twenty times across the basket templates and defined nowhere at
                     all, so those rows were unstyled AND unthemed. See the file. -->
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <xamlHelpers:MaterialIconGlyphConverter x:Key="MaterialIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>