<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Frontend.ClientUI.Pages.MainTill.Inventory.ViewAllInventoryPage"
             xmlns:models="clr-namespace:Plutus.Entities.Models;assembly=Plutus.Entities"
             xmlns:ext="clr-namespace:Plutus.Frontend.ClientUI.XAML.Extensions"
             xmlns:vms="clr-namespace:Plutus.Frontend.ClientUI.ViewModels.MainTill.Inventory"
             xmlns:I18N_L10N="clr-namespace:Plutus.Frontend.ClientUI.Resources.I18N_L10N"
             xmlns:vm="clr-namespace:Plutus.Frontend.ClientUI.ViewModels.MainTill.Inventory"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:DataType="vm:ViewAllInventoryViewModel"
             Shell.NavBarIsVisible="{OnPlatform True, MacCatalyst=False}"
             Title="{OnIdiom {Binding Title}, Desktop=''}">
    <ContentPage.Resources>
        <ext:StockToStringConverter x:Key="StockToString"/>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Orientation="Horizontal">
                <SearchBar Placeholder="{x:Static I18N_L10N:Strings.Search}" Text="{Binding SearchText}"
                           TextColor="{x:DynamicResource Primary}" FontSize="Medium"
                           HorizontalOptions="FillAndExpand"/>
                <Button Text="{x:Static I18N_L10N:Strings.AddItem}" Command="{Binding OpenAddItemCommand}"
                        HorizontalOptions="End"/>
                <Button Text="Testing Stock" Command="{Binding TestStockChangeCommand}"
                        HorizontalOptions="End"/>
            </StackLayout>
            <ListView x:Name="inventoryListView" ItemsSource="{Binding Items}" IsRefreshing="{Binding IsRefreshing}">
                <ListView.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".8*"/>
                            <ColumnDefinition Width=".1*"/>
                            <ColumnDefinition Width=".1*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="Medium" FontAttributes="Bold" Text="Name" />
                        <Label Grid.Column="1" FontSize="Medium" FontAttributes="Bold" Text="Price" />
                        <Label Grid.Column="2" FontSize="Medium" FontAttributes="Bold" Text="Stock" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Item">
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="{x:Static I18N_L10N:Strings.AddToBasket}"
                                          Command="{Binding Source={x:Reference inventoryListView}, Path=BindingContext.AddToBasketCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Text="{x:Static I18N_L10N:Strings.Edit}"
                                          Command="{Binding Source={x:Reference inventoryListView}, Path=BindingContext.OpenEditItemCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Text="{x:Static I18N_L10N:Strings.UpdateStock}"
                                          Command="{Binding Source={x:Reference inventoryListView}, Path=BindingContext.UpdateItemStockCommand}"
                                          CommandParameter="{Binding .}" />
                            </ViewCell.ContextActions>
                            <ViewCell.View>
                                <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width=".8*" />
                                        <ColumnDefinition Width=".1*" />
                                        <ColumnDefinition Width=".1*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="Small" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat='{0:C}'}" FontSize="Small"/>
                                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding Stock, Converter={StaticResource StockToString}}" FontSize="Small"/>
                                </Grid>
                            </ViewCell.View>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
