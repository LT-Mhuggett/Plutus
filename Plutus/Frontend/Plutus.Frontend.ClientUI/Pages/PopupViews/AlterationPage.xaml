<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Plutus.Frontend.ClientUI.Pages.PopupViews.AlterationPage"
               xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
               xmlns:I18N_L10N="clr-namespace:Plutus.Frontend.ClientUI.Resources.I18N_L10N"
               Color="Transparent">
    <Frame CornerRadius="{OnPlatform Default='10', Android='15', UWP='15'}"
           BackgroundColor="WhiteSmoke"
           HasShadow="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"  />
                <RowDefinition Height=".5*" />
                <RowDefinition Height=".5*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="3*"  />
                <RowDefinition Height="1*"  />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="3"
                   Text="{x:Static I18N_L10N:Strings.Alterations}"
                   FontSize="Subtitle" FontAttributes="Bold" />
            <Label Grid.Row="1" Grid.ColumnSpan="3"
                   Text="{Binding Discount.Type, Converter={x:StaticResource DiscountTypeToText}}" />
            <Label Grid.Row="2" Grid.RowSpan="3"
                   Text="{Binding Discount.Amount}" />
            <Label Grid.Row="3" Grid.RowSpan="3" Text="{x:Static I18N_L10N:Strings.Items}"
                   FontSize="Subtitle"/>
            <syncfusion:SfListView x:Name="sfListView" Grid.Row="4" Grid.ColumnSpan="3"
                                   ItemsSource="{Binding BasketItems}" SelectedItems="{Binding SelectedItems}" SelectionMode="Multiple" SelectionGesture="Tap"
                                   ItemSize="30"
                                   BackgroundColor="WhiteSmoke" ItemSpacing="5,0,5,5">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                                <Label Text="{Binding Name}"/>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
            <!--<CollectionView Grid.Row="3" Grid.ColumnSpan="2"
                            ItemsSource="{Binding BasketItems}" SelectionMode="Multiple" SelectedItems="{Binding SelectedItems}"
                            SelectionChangedCommand="{Binding BasketItemSelectionChangedCommand}">
                <CollectionView.Header>
                    <Label Text="{x:Static I18N_L10N:Strings.Items}"
                           FontSize="Medium"/>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Text="{Binding Name}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>-->
            <Button Grid.Row="5" Grid.Column="0"
                    Text="{x:Static I18N_L10N:Strings.Cancel}" Command="{Binding CancelAlterationCommand}" />
            <Button Grid.Row="5" Grid.Column="1"
                    Text="{Binding SelectAllText}" Command="{Binding SelectAllCommand}" CommandParameter="{x:Reference sfListView}" />
            <Button Grid.Row="5" Grid.Column="2"
                    Text="{x:Static I18N_L10N:Strings.Confirm}" Command="{Binding ConfirmAlterationCommand}" />
        </Grid>
    </Frame>
</toolkit:Popup>
