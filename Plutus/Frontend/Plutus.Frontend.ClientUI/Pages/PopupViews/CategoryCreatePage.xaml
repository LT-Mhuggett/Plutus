<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Plutus.Frontend.ClientUI.Pages.PopupViews.CategoryCreatePage"
               xmlns:vm="clr-namespace:Plutus.Frontend.ClientUI.ViewModels.PopupViewModels"
               xmlns:I18N_L10N="clr-namespace:Plutus.Frontend.ClientUI.Resources.I18N_L10N"
               x:DataType="vm:CategoryCreateViewModel"
               Color="Transparent">
    <Frame CornerRadius="{OnPlatform Default='10', Android='15', UWP='15'}"
           BackgroundColor="WhiteSmoke"
           HasShadow="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height=".5*" />
                <RowDefinition Height=".5*" />
                <RowDefinition Height=".5*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{x:Static I18N_L10N:Strings.Category}"
                   FontSize="Subtitle" FontAttributes="Bold" />
            <Label Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{x:Static I18N_L10N:Strings.Name}" />
            <Entry Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding Category.Name}" />
            <Label Grid.Row="3" Grid.ColumnSpan="2"
                   Text="{x:Static I18N_L10N:Strings.Description}" />
            <Editor Grid.Row="4" Grid.ColumnSpan="2"
                   Text="{Binding Category.Description}" />
            <Button Grid.Row="5" Grid.Column="0"
                    Text="{x:Static I18N_L10N:Strings.Cancel}" Command="{Binding CancelCategoryCreateCommand}" />
            <Button Grid.Row="5" Grid.Column="1"
                    Text="{x:Static I18N_L10N:Strings.Create}" Command="{Binding CategoryCreateCommand}" />
        </Grid>
    </Frame>
</toolkit:Popup>