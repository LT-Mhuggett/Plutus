<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Frontend.ClientUI.Pages.LoginPage"
             BackgroundColor="{DynamicResource Secondary}">
    <ContentPage.Content>
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width=".2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0"
                   Text="Welcome to Plutus" FontSize="80"
                   VerticalOptions="CenterAndExpand" 
                   HorizontalOptions="CenterAndExpand" />
            <BoxView Grid.Row="0" Grid.Column="1"                        
                     HeightRequest="500" WidthRequest="2"
                     VerticalOptions="Fill" Color="{DynamicResource Primary}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Padding="0,20"
                    Text="Login" Command="{Binding LoginCommand}"
                    VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand" />
        </Grid>
    </ContentPage.Content>
</ContentPage>