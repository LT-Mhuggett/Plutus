	<ItemGroup>
	  <ProjectReference Include="..\..\Commons\CommonPOSLibrary\CommonPOSLibrary.csproj" />
	  <ProjectReference Include="..\..\Commons\CoppperToCSV\CoppperToCSV.csproj" />
