<?xml version="1.0" encoding="UTF-8"?>
<StackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plutus.Frontend.ClientUI.XAML.Controls"
             x:Class="Plutus.Frontend.ClientUI.XAML.Controls.SteppedSliderWithLabels">
    <StackLayout x:Name="labelStack" HorizontalOptions="FillAndExpand" Orientation="Horizontal" Spacing="0"/>
    <controls:SteppedSlider x:Name="slider" ValueChanged="Slider_ValueChanged" HorizontalOptions="FillAndExpand"/>
</StackLayout>