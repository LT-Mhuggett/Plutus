<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:windows="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.WindowsSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:Plutus.Frontend.ClientUI"
             xmlns:extensions="clr-namespace:Plutus.Frontend.ClientUI.XAML.Extensions"
             xmlns:vms="clr-namespace:Plutus.Frontend.ClientUI.ViewModels"
             x:Class="Plutus.Frontend.ClientUI.App"
             windows:Application.ImageDirectory="Assets">
    <Application.Resources>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
        <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
        <ResourceDictionary Source="Resources/Styles/FontIcons.xaml"/>
        <ResourceDictionary>
            <extensions:DiscountTypeToTextConverter x:Key="DiscountTypeToText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>