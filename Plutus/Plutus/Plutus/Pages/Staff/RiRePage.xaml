<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Staff.RiRePage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate Ri_Re}">
    <StackLayout>
        <ListView ItemsSource="{Binding Items}"
            HasUnevenRows="True"
            CachingStrategy="RecycleElement">
            <ListView.Header>
                <Grid Padding="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Text="{i18N:Translate Name}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{i18N:Translate V}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{i18N:Translate M}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{i18N:Translate A}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{i18N:Translate X}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{i18N:Translate R}"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"/>
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding Active}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="Confirm" Text="{i18N:Translate Confirm}" Clicked="Confirm_Clicked" />
    </StackLayout>
</ContentPage>