<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Staff.EmployeeDeactivationPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate StaffDeactiv}">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Only use this section to deactivate a staff members profile!"/>
            <Picker x:Name="EmpList"/>
            <Button x:Name="ConfirmDeactiv" Text="CONFIRM DEACTIVATION!!!" Clicked="ConfirmDeactiv_Clicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>