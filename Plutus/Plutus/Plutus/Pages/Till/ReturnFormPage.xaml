<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Till.ReturnFormPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate Returns}">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="{i18N:Translate Item}" HorizontalOptions="Start"/>
            <Label x:Name="ItemName" />
            <Label Text="{i18N:Translate SaleID}" HorizontalOptions="Start"/>
            <Entry x:Name="SaleID" />
            <Label Text="{i18N:Translate Reason}" />
            <Entry x:Name="Reason" />
            <Button x:Name="Confirm" Text="{i18N:Translate Confirm}" Clicked="Confirm_Clicked"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>