<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Reports.MainPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate Reports}"
             Icon="">
    <ContentPage.Content>
        <StackLayout>
            <Grid>
                <StackLayout x:Name="MPage" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Button x:Name="SalesReps" Text="{i18N:Translate SReports}" Clicked="SalesReps_Clicked"/>
                    <Button x:Name="WSOutReps" Text="Weekly Stock Outtakes" Clicked="WSOutReps_Clicked"/>
                </StackLayout>
                <StackLayout x:Name="VerifyId"  IsVisible="False" BackgroundColor="White" Margin="50,100,50,200">
                    <Label Text="{i18N:Translate EmpId}" />
                    <Entry x:Name="EId" />
                    <Button x:Name="Confirm" Text="{i18N:Translate Confirm}"/>
                    <Button x:Name="CancelEmpCheck" Text="{i18N:Translate Cancel}" Clicked="CancelEmpCheck_Clicked" />
                </StackLayout>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>