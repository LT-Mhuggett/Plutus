<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Reports.SalesReportsPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate SReports}">
    <StackLayout>
        <Label Text="{i18N:Translate EmpIdORDate}" />
        <Entry x:Name="EmpSearch" Completed="EmpSearchCompleted" />
        <Picker x:Name="DateSearch" SelectedIndexChanged="DateSearchChange" />
        <ListView ItemsSource="{Binding Sales}"
            ItemTapped="Handle_ItemTapped"
            CachingStrategy="RecycleElement">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout>
                            <Label Text="{Binding SaleId}" 
                            Style="{DynamicResource ListItemTextStyle}" />
                            <Label Text="{Binding Total}" 
                            Style="{DynamicResource ListItemDetailTextStyle}"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>