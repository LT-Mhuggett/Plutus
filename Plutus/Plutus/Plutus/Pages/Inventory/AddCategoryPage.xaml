<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Inventory.AddCategoryPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate NewCate}">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="{i18N:Translate Name}" />
            <Entry x:Name="Name" />
            <Label Text="{i18N:Translate Desc}" />
            <Entry x:Name="Description" />
            <Button x:Name="Confirm" Text="{i18N:Translate Confirm}" Clicked="Confirm_Clicked" />
            <Button x:Name="Cancel" Text="{i18N:Translate Cancel}" Clicked="Cancel_Clicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>