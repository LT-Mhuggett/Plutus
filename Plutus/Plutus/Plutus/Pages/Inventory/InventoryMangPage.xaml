<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Inventory.InventoryMangPage"
             Title="Inventory Management"
             Icon="">
    <ContentPage.Content>
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
            <Button x:Name="AddItem" Text="Add Item" Clicked="AddItem_Clicked"/>
            <Button x:Name="UpdateItem" Text="Update Item" Clicked="UpdateItem_Clicked"/>
            <Button x:Name="StockUpdate" Text="Stock" Clicked="StockUpdate_Clicked"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>