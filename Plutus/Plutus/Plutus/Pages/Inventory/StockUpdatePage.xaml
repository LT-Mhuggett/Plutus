<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Inventory.StockUpdatePage"
             Title="Stock Update">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="ID" HorizontalOptions="FillAndExpand" />
            <Entry x:Name="Id" Unfocused="Id_Unfocused" Focused="Id_Focused"/>
            <Label Text="Quantity to add" HorizontalOptions="FillAndExpand" />
            <Entry x:Name="Quantity" Keyboard="Numeric"/>
            <Button x:Name="Confirm" Text="confirm" Clicked="Confirm_Clicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>