<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Inventory.StockUpdatePage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate StockUpdate}">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="ID" HorizontalOptions="FillAndExpand" />
            <Entry x:Name="Id" Completed="Id_Completed" />
            <Button x:Name="ScanButt" Text="Scan" Clicked="ScanButt_Clicked" />
            <Label Text="{i18N:Translate QuantityAdd}" HorizontalOptions="FillAndExpand" />
            <Entry x:Name="Quantity" Keyboard="Numeric"/>
            <Button x:Name="Confirm" Text="{i18N:Translate Confirm}" Clicked="Confirm_Clicked" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>