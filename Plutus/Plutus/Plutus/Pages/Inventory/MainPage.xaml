<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Inventory.MainPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate InvetMgr}"
             Icon="">
    <ContentPage.Content>
        <Grid>
            <StackLayout x:Name="MPage" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
            <Button x:Name="AddItem" Text="{i18N:Translate AddItem}" Clicked="AddItem_Clicked" />
            <Button x:Name="UpdateItem" Text="{i18N:Translate UpdateItem}" Clicked="UpdateItem_Clicked" />
            <Button x:Name="StockUpdate" Text="{i18N:Translate StockUpdate}" Clicked="StockUpdate_Clicked" />
            <Button x:Name="ViewAllI" Text="{i18N:Translate VAllItems}" Clicked="ViewAllI_Clicked" />
            <Button x:Name="MassUpdate" Text="Mass Update" Clicked="MassUpdate_Clicked"/>
        </StackLayout>
        <StackLayout x:Name="VerifyId"  IsVisible="False" BackgroundColor="White" Margin="50,100,50,200">
            <Label Text="{i18N:Translate EmpId}" />
            <Entry x:Name="EId" />
            <Button x:Name="Confirm" Text="{i18N:Translate Confirm}"/>
            <Button x:Name="CancelEmpCheck" Text="{i18N:Translate Cancel}" Clicked="CancelEmpCheck_Clicked" />
        </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>