<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Admin.MainPage"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="{i18N:Translate Admin}"
             Icon="">
    <ContentPage.Content>
        <Grid>
            <StackLayout x:Name="MPage" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                <Button x:Name="BackUpButt" Text="{i18N:Translate BackUp}" Clicked="Backup_Clicked"/>
                <Button x:Name="RestoreButt" Text="{i18N:Translate Restore}" Clicked="Restore_Clicked"/>
                <Label x:Name="VersionLabel" Text=""/>
            </StackLayout>
            <StackLayout x:Name="VerifyId"  IsVisible="False" BackgroundColor="White" Margin="50,100,50,200">
                <Label Text="{i18N:Translate EmpId}" />
                <Entry x:Name="EId" />
                <Button x:Name="Confirm" Text="{i18N:Translate Confirm}"/>
                <Button x:Name="CancelEmpCheck" Text="{i18N:Translate Cancel}" Clicked="CancelEmpCheck_Clicked" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>