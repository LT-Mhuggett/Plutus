<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.Admin.AddPaymentMeth"
             xmlns:i18N="clr-namespace:I18N_L10N;assembly=I18N_L10N"
             Title="New Payment Method">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout BackgroundColor="Transparent"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="FillAndExpand"
                         Margin="10,0,10,0">
                <Label Text="{i18N:Translate Name}"/>
                <Entry Text="{Binding Name}"/>
                <Label Text="Any charge to use this method"/>
                <Entry Text="{Binding Charge}"/>
                <Label Text="Input the minimum spend to use this method"/>
                <Entry Text="{Binding MinimumCharge}"/>
                <Label Text="Is Change give for this method"/>
                <Switch IsToggled="{Binding IsChangeable}"/>
                <Label Text="Is cash back an option for this method"/>
                <Switch IsToggled="{Binding IsCashbackable}"/>
                <Button Text="{i18N:Translate Confirm}" Clicked="Conf_Clicked"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>