<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plutus.Pages.UsersLoggedPage">
    <StackLayout>
        <ListView ItemsSource="{Binding Emps}"
            ItemTapped="Handle_ItemTapped"
            CachingStrategy="RecycleElement"
            SeparatorVisibility="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Clicked="OnDelete" CommandParameter="{Binding .}"
                            Text="Log Out" IsDestructive="True" />
                        </ViewCell.ContextActions>
                        <StackLayout>
                            <Label Text="{Binding LName}" FontAttributes="Bold"/>
                            <Label Text="{Binding FName}" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="NewUserLogin" Text="New User Login" Clicked="NewUserLogin_Clicked" />
        <Button x:Name="LogoutAll" Text="Logout All" Clicked="LogoutAll_Clicked" />
    </StackLayout>
</ContentPage>