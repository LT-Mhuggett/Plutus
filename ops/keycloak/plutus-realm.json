{
  "realm": "plutus",
  "enabled": true,
  "displayName": "Plutus",
  "loginTheme": "plutus",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultDefaultClientScopes": ["profile", "email", "roles"],
  "defaultOptionalClientScopes": ["offline_access"],
  "clientScopes": [
    {
      "name": "plutus-api-audience",
      "description": "Adds aud=plutus-api so Plutus backend accepts the token",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "plutus-api-aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "plutus-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Minimal profile scope (an explicit clientScopes list suppresses Keycloak's built-ins, so the ones we use are defined here)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": { "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email claim — the backend's RbacClaimsTransformation matches it to a Plutus user",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email", "claim.name": "email", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles in realm_access.roles (WP18.1 maps platform-admin from here) + client roles in resource_access (Keycloak account console needs this)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true", "claim.name": "realm_access.roles", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true", "claim.name": "resource_access.${client_id}.roles", "jsonType.label": "String",
            "id.token.claim": "false", "access.token.claim": "true", "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "plutus-portal",
      "name": "Plutus Management Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "https://admin.plutus.huggett.dscloud.me",
      "baseUrl": "/",
      "redirectUris": [
        "https://admin.plutus.huggett.dscloud.me/*",
        "http://localhost:5274/*"
      ],
      "webOrigins": [
        "https://admin.plutus.huggett.dscloud.me",
        "http://localhost:5274"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://admin.plutus.huggett.dscloud.me/*##http://localhost:5274/*"
      },
      "defaultClientScopes": ["profile", "email", "roles", "plutus-api-audience"]
    },
    {
      "clientId": "plutus-webpos",
      "name": "Plutus Web POS (till)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "https://plutus.huggett.dscloud.me",
      "baseUrl": "/",
      "redirectUris": [
        "https://plutus.huggett.dscloud.me/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://plutus.huggett.dscloud.me",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://plutus.huggett.dscloud.me/*##http://localhost:5173/*"
      },
      "defaultClientScopes": ["profile", "email", "roles", "plutus-api-audience"]
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "baseUrl": "/realms/plutus/account/",
      "redirectUris": ["/realms/plutus/account/*"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["profile", "email", "roles"]
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/plutus/account/",
      "redirectUris": ["/realms/plutus/account/*"],
      "webOrigins": [],
      "fullScopeAllowed": true,
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["profile", "email", "roles"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Plutus operator platform admin (WP18.1) — maps to the platform-admin scope the backend policy requires." }
    ]
  },
  "groups": [
    { "name": "operators", "realmRoles": ["platform-admin"] }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "users": [
    {
      "username": "matt",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Matt",
      "lastName": "Huggett",
      "email": "matt@huggett.co.uk",
      "groups": ["/operators"],
      "realmRoles": ["default-roles-plutus"],
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "credentials": [
        { "type": "password", "value": "ChangeMe!2026", "temporary": true }
      ]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Plutus",
      "lastName": "Operator",
      "email": "ops@plutus.test",
      "groups": ["/operators"],
      "realmRoles": ["default-roles-plutus"],
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        { "type": "password", "value": "ChangeMe!2026", "temporary": false }
      ]
    },
    {
      "username": "ada",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Cashier",
      "email": "ada@shop.test",
      "realmRoles": ["default-roles-plutus"],
      "credentials": [
        { "type": "password", "value": "ChangeMe!2026", "temporary": false }
      ]
    }
  ]
}
